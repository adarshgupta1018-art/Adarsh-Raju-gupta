rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is an authenticated administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'adarshgupta1018@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Tournaments Collection
    // Publicly readable so players can see the schedule, map, entry fee, and slot capacity.
    // Only authorized administrators can update tournament details or room credentials.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registrations Collection
    // 1. Players can submit (create) their registration with validation on required fields.
    // 2. Only authorized administrators can read all registrations (protecting player WhatsApp, payment ref, etc.).
    // 3. Only authorized administrators can update (approve/reject/add notes) or delete registrations.
    match /registrations/{registrationId} {
      allow create: if request.resource.data.playerName is string
                    && request.resource.data.playerName.size() >= 2
                    && request.resource.data.ffUid is string
                    && request.resource.data.ffUid.size() >= 5
                    && request.resource.data.tournamentId is string
                    && request.resource.data.selectedSlot is int
                    && request.resource.data.selectedSlot >= 1
                    && request.resource.data.selectedSlot <= 20
                    && request.resource.data.status == 'PENDING';
      
      // Reading registrations: Only authorized admin can view the full records.
      // Alternatively, allow unauthenticated read only if querying for slot availability.
      allow read: if isAdmin();
      
      // Updating or deleting registrations: Admin only
      allow update, delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
